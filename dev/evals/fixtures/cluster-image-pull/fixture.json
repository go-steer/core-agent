{
  "name": "cluster-image-pull",
  "description": "A four-namespace cluster in which exactly one Deployment references an image tag the registry does not have, reachable only through the shared kubectl shim.",
  "roles": {
    "world": {
      "path": "cluster.json"
    },
    "tools": {
      "path": "bin",
      "probes": ["kubectl"]
    },
    "workspace": {
      "path": "workspace",
      "probes": ["NOTES.md"]
    }
  },
  "path_role": "tools",
  "workdir_role": "workspace",
  "facts_from": "world#planted",
  "witnesses": {
    "cluster-reads": "witness/cluster-reads.log"
  },
  "env": {
    "EVAL_WORLD": "${role.world}",
    "EVAL_WITNESS_CLUSTER_READS": "${witness.cluster-reads}"
  }
}
