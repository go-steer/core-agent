# Local CI runner — executes every check the GitHub Actions workflow runs,
# in fast-fail order. Mirrors dev/ci/presubmits/* so a green run here
# means a green run there.
#
# Usage:
#   dev/tools/ci              # run everything, stop on first failure
#   dev/tools/ci --keep-going # report all failures (don't stop early)
set -euo pipefail
. "$(dirname "$0")/common.sh"

cd "$(repo_root)"

KEEP_GOING=0
for arg in "$@"; do
  case "$arg" in
    --keep-going) KEEP_GOING=1 ;;
    -h|--help)
      echo "Usage: dev/tools/ci [--keep-going]"
      exit 0
      ;;
    *)
      echo "Unknown flag: $arg" >&2
      exit 2
      ;;
  esac
done

# Order matters: cheap, format-style checks first; the slow scanners last.
# Every script in dev/ci/presubmits/* (except e2e-*) must appear here, or the
# coverage guard below fails before running anything (#1394).
STEPS=(
  "docs-lint         dev/tools/docs-lint"
  "attribution       dev/tools/verify-no-agent-attribution"
  "toolchain         dev/tools/verify-go-toolchain"
  "action-pins       dev/tools/verify-action-pins"
  "version-fallback  dev/tools/verify-version-fallback"
  "format            dev/tools/verify-go-format"
  "vet               dev/tools/vet"
  "build             dev/tools/build"
  "coretui-guards    dev/tools/verify-coretui-guards"
  "corevcs-pin       dev/tools/verify-core-vcs-pin"
  "slim-deps         dev/tools/verify-slim-deps"
  "apidiff           dev/tools/verify-apidiff"
  "config-pins       dev/tools/verify-harness-config-pinned"
  "lint              dev/tools/lint-go"
  "mod-tidy          dev/tools/verify-mod-tidy"
  "test              dev/tools/test-unit"
  "evals             dev/tools/evals"
  "examples          dev/tools/examples-smoke"
  "gke-drill         dev/tools/verify-gke-drill"
  "terraform         dev/tools/verify-terraform"
  "release-notes     dev/tools/verify-release-notes"
  "vuln              dev/tools/verify-vuln"
)

# Verify that every non-e2e script in dev/ci/presubmits/ is covered by STEPS.
missing_presubmits=()
for presubmit in dev/ci/presubmits/*; do
  name="$(basename "$presubmit")"
  case "$name" in
    e2e-*) continue ;;
  esac
  # Resolve the dev/tools/ target that the presubmit delegates to (or matches by name).
  target="dev/tools/${name}"
  if [[ ! -e "$target" && "$name" == "verify-docs-lint" ]]; then
    target="dev/tools/docs-lint"
  fi
  found=0
  for entry in "${STEPS[@]}"; do
    cmd="${entry#* }"
    cmd="${cmd##* }"
    if [[ "$cmd" == "$target" || "$cmd" == "$presubmit" ]]; then
      found=1
      break
    fi
  done
  if [[ "$found" -eq 0 ]]; then
    missing_presubmits+=("$presubmit")
  fi
done
if [[ "${#missing_presubmits[@]}" -gt 0 ]]; then
  printf 'dev/tools/ci: presubmits missing from STEPS: %s\n' "${missing_presubmits[*]}" >&2
  exit 1
fi

failures=()
for entry in "${STEPS[@]}"; do
  label="${entry%% *}"
  cmd="${entry#* }"
  cmd="${cmd##* }"
  if run_step "$label" "$cmd"; then
    continue
  fi
  failures+=("$label")
  if [[ "$KEEP_GOING" -eq 0 ]]; then
    echo
    echo "✗ $label failed — aborting (pass --keep-going to run all checks)" >&2
    exit 1
  fi
done

echo
if [[ "${#failures[@]}" -eq 0 ]]; then
  echo "✓ all CI checks passed"
else
  printf '✗ failures: %s\n' "${failures[*]}" >&2
  exit 1
fi
