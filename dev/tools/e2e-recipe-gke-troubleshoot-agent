# End-to-end deployment + pipeline smoke test for the GKE-troubleshoot
# recipe.
#
# Spins up a local kind cluster, deploys examples/gke-troubleshoot-agent/
# as an operator would (matching the DEMO.md flow), and asserts that:
#
#   1. Both Deployments reach 1/1 Ready within the rollout timeout.
#   2. The attach listener responds to an authenticated /sessions probe.
#   3. The daemon startup log contains the expected fingerprint (attach
#      listener bound, instruction file(s) loaded) and NO error lines.
#   4. The PIPELINE FLOWS (hermetically, on the echo provider): a
#      deliberately broken pod fires a Warning event → lookout's filter
#      passes it → the watcher's authenticated POST /sessions +
#      /sessions/<sid>/inject lands in the daemon (per-incident mode:
#      one new session per (uid, reason)) → the daemon's wake loop
#      drains the inject into a real model turn (echo mirrors the
#      injected payload back as the model response).
#
# What this catches (from the v2.6 demo drive):
#
#   ✓ Missing namespace on generated ConfigMaps → pod hangs on
#     FailedMount → rollout times out
#   ✓ Wrong daemon args (--config vs -c, nonexistent --agents-dir) →
#     daemon exits at flag-parse → CrashLoopBackOff
#   ✓ Split-configMap layout the daemon can't reconcile → CrashLoop
#   ✓ Volume mount conflicts under /etc/core-agent → containerd init
#     fails → pod stuck
#   ✓ users.json + fsGroup permission mismatch → daemon exits at
#     auth-load → CrashLoop
#   ✓ Wrong readiness probe (401 counted as failure) → pod stays 0/1
#     Ready → rollout times out
#   ✓ AGENTS.md load-path mismatch (agents/ vs .agents/) → daemon
#     boots with empty instructions → "instruction: loaded" log line
#     absent → assertion FAIL
#
# What this deliberately does NOT catch:
#
#   ✗ Agent reasoning quality / tool-call correctness (record_plan
#     writes, MCP-driven remediation) — belongs to a live-cluster e2e
#     that costs Vertex quota. The pipeline assertion (#4) only proves
#     the event → inject → turn plumbing; the "model" is echo.
#   ✗ Vertex-init specifically — this test uses --provider=echo to
#     avoid requiring GCP creds. Vertex config bugs (missing
#     GOOGLE_CLOUD_PROJECT, wrong location) are caught INDIRECTLY:
#     if the recipe's core-agent-gcp-env ConfigMap is missing, the
#     Deployment's envFrom would fail to expand → CreateContainerError.
#
# Runtime: ~4-8 min wall clock (docker build from HEAD ~2-4 min cold,
# seconds warm; kind create ~30s; rollout ~60s;
# probe/logs ~10s; pipeline assertion ~45-120s — dominated by waiting
# for kubelet's first image-pull BackOff event; cleanup ~15s).

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# --- config ------------------------------------------------------------

CLUSTER_NAME="${CLUSTER_NAME:-e2e-gke-troubleshoot}"
NAMESPACE="${NAMESPACE:-agent-triage}"
# Daemon image: empty (the default) builds core-agent from the
# CURRENT CHECKOUT and side-loads it into kind, so every PR's e2e
# exercises the code under review against the pinned watcher. That's
# what catches daemon-side API skew: the #383 CSRF guard 415'd
# lookout's bodyless POST /sessions in production while this e2e
# stayed green, because it pinned a pre-guard core-agent:2.6.0.
# Set DAEMON_IMAGE to a published tag to smoke that tag instead.
DAEMON_IMAGE="${DAEMON_IMAGE:-}"
# The watcher migrated to go-steer/k8s-lookout's published image: a
# multicall binary whose container ENTRYPOINT is `lookout watch`,
# drop-in image-swap compatible with the retired
# ghcr.io/go-steer/k8s-event-watcher image. Keep this pin current:
# an old watcher pin hides daemon↔watcher protocol skew (and vice
# versa — v0.8.0 through v0.10.0 lack the Content-Type fix the
# current daemon's CSRF guard requires).
WATCHER_IMAGE="${WATCHER_IMAGE:-ghcr.io/go-steer/lookout:v0.11.0}"
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-180s}"
# Seconds allowed for the whole event → inject → echo-turn pipeline
# (phase 9). Typical pass is ~30-60s; the long pole is kubelet's first
# "Back-off pulling image" event (~10-30s after pod creation).
PIPELINE_TIMEOUT="${PIPELINE_TIMEOUT:-120}"

# --- prereqs -----------------------------------------------------------

for tool in kind kubectl docker openssl jq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "e2e: missing required tool: $tool" >&2
        exit 1
    fi
done

# --- scratch state cleanup --------------------------------------------

SCRATCH_DIR="$(mktemp -d -t e2e-gke-troubleshoot-XXXXXX)"
PF_PID=""
PF2_PID=""

cleanup() {
    local exit_code=$?
    set +e
    # Dump diagnostics on failure so CI logs are actionable.
    if [[ $exit_code -ne 0 ]]; then
        echo ""
        echo "=== FAIL DIAGNOSTICS (exit=$exit_code) ==="
        kubectl -n "$NAMESPACE" get pods 2>&1 | head -20 || true
        kubectl -n "$NAMESPACE" get events --sort-by='.lastTimestamp' 2>&1 | tail -30 || true
        echo ""
        echo "--- daemon logs ---"
        kubectl -n "$NAMESPACE" logs deployment/core-agent --tail=100 --all-containers=true 2>&1 || true
        echo ""
        echo "--- watcher logs ---"
        kubectl -n "$NAMESPACE" logs deployment/k8s-event-watcher --tail=50 2>&1 || true
        echo "=== END DIAGNOSTICS ==="
    fi
    if [[ -n "$PF_PID" ]]; then
        kill "$PF_PID" 2>/dev/null || true
    fi
    if [[ -n "$PF2_PID" ]]; then
        kill "$PF2_PID" 2>/dev/null || true
    fi
    kind delete cluster --name "$CLUSTER_NAME" >/dev/null 2>&1 || true
    rm -rf "$SCRATCH_DIR"
}
trap cleanup EXIT

# --- phase 1: cluster --------------------------------------------------

echo "▸ create kind cluster ($CLUSTER_NAME)"
kind create cluster --name "$CLUSTER_NAME" --wait 60s

# Build the daemon from HEAD unless a published tag was requested.
# imagePullPolicy in the base is IfNotPresent, so the side-loaded
# local tag is used as-is and never triggers a registry pull.
if [[ -z "$DAEMON_IMAGE" ]]; then
    DAEMON_IMAGE="local/core-agent:e2e-$(git rev-parse --short HEAD)"
    echo "▸ build daemon image from HEAD ($DAEMON_IMAGE)"
    # Same go.mod-extraction idiom as release-images.yml: the
    # Dockerfile's GO_VERSION default drifts behind go.mod (official
    # golang images set GOTOOLCHAIN=local, so no auto-upgrade), and
    # without this arg `go mod download` fails the build the first
    # time go.mod's directive moves past the default.
    GO_VERSION=$(grep -E '^go [0-9]+\.[0-9]+(\.[0-9]+)?$' go.mod | awk '{print $2}')
    docker build --build-arg GO_VERSION="$GO_VERSION" -t "$DAEMON_IMAGE" .
    kind load docker-image --name "$CLUSTER_NAME" "$DAEMON_IMAGE"
fi

# --- phase 2: stage scratch deploy tree -------------------------------

echo "▸ stage scratch deploy tree at $SCRATCH_DIR/deploy"
cp -r examples/gke-troubleshoot-agent/deploy "$SCRATCH_DIR/deploy"
OVERLAY_DIR="$SCRATCH_DIR/deploy/overlays/example"
BASE_AGENTS_MD="$SCRATCH_DIR/deploy/base/config/AGENTS.md"

# Cluster-name placeholder in the watcher patch — same sed the DEMO.md
# runbook does. E2E cluster name is a stand-in; watcher inject payloads
# will report this as the "cluster" field.
sed -i "s/prod-us-central1/e2e-kind/g" \
    "$OVERLAY_DIR/patch-watcher-cluster-name.yaml"

# AGENTS.md project/cluster/location need no sed since #323: the file
# interpolates ${env:GCP_PROJECT} etc. at daemon boot, fed via envFrom
# from the core-agent-gcp-env ConfigMap. The base kustomization's
# literal defaults are wrong-for-kind but present, which is all the
# echo-provider boot path requires (env.yaml only fail-louds on
# MISSING vars). Guard against the placeholder pattern resurfacing:
if grep -qE "__GCP_PROJECT__|__GKE_CLUSTER__|__GKE_LOCATION__" "$BASE_AGENTS_MD"; then
    echo "e2e: AGENTS.md grew __PLACEHOLDER__ tokens again — the daemon" >&2
    echo "     no longer substitutes these; use \${env:VAR} + env.yaml instead" >&2
    exit 1
fi

# --- phase 3: overlay patches for e2e environment ---------------------

# Force --provider=echo so the daemon starts without requiring GCP creds.
# The echo provider satisfies the model.provider registry check without
# any credential fetch, which is what lets this test run on kind with
# no Vertex/Anthropic access. Real provider integration is validated
# separately by the live-cluster smoke.
#
# Also add a container image override for reproducibility — the base
# ships with :latest by default; overlays/example pins to a specific
# tag but a future recipe change might drop that. Explicit here.
cat >> "$OVERLAY_DIR/kustomization.yaml" <<EOF

# --- e2e-only overlays (appended by dev/tools/e2e-recipe-gke-troubleshoot-agent) ---
images:
  - name: ghcr.io/go-steer/core-agent
    newName: ${DAEMON_IMAGE%:*}
    newTag: ${DAEMON_IMAGE##*:}
  - name: ghcr.io/go-steer/lookout
    newName: ${WATCHER_IMAGE%:*}
    newTag: ${WATCHER_IMAGE##*:}

# Patch daemon args to add --provider=echo (skips Vertex init).
patches:
  - target:
      kind: Deployment
      name: core-agent
    patch: |-
      - op: add
        path: /spec/template/spec/containers/0/args/-
        value: "--provider=echo"
EOF

# --- phase 4: bootstrap namespace + Secrets (out-of-band per recipe) --

echo "▸ create namespace + Secrets"
kubectl create namespace "$NAMESPACE"

SRE_TOKEN=$(openssl rand -hex 32)
BOB_TOKEN=$(openssl rand -hex 32)
WATCHER_TOKEN=$(openssl rand -hex 32)
USERS_JSON="$SCRATCH_DIR/users.json"
cat > "$USERS_JSON" <<EOF
{
  "version": 1,
  "users": [
    { "identity": "sre-oncall@example.com", "token": "$SRE_TOKEN" },
    { "identity": "bob@example.com",        "token": "$BOB_TOKEN" },
    { "identity": "sa:k8s-event-watcher",   "token": "$WATCHER_TOKEN" }
  ]
}
EOF
chmod 0600 "$USERS_JSON"

kubectl -n "$NAMESPACE" create secret generic core-agent-users \
    --from-file=users.json="$USERS_JSON"
kubectl -n "$NAMESPACE" create secret generic k8s-event-watcher-token \
    --from-literal=token="$WATCHER_TOKEN"

# --- phase 5: apply overlay -------------------------------------------

echo "▸ kubectl apply -k"
kubectl apply -k "$OVERLAY_DIR"

echo "▸ wait for rollouts ($ROLLOUT_TIMEOUT max)"
kubectl -n "$NAMESPACE" rollout status deployment/core-agent \
    --timeout="$ROLLOUT_TIMEOUT"
kubectl -n "$NAMESPACE" rollout status deployment/k8s-event-watcher \
    --timeout="$ROLLOUT_TIMEOUT"

# --- phase 6: probe attach listener -----------------------------------

echo "▸ port-forward + probe attach listener"
kubectl -n "$NAMESPACE" port-forward svc/core-agent 7777:7777 >/dev/null 2>&1 &
PF_PID=$!
# Give port-forward a beat to establish; kubectl doesn't expose a
# ready-signal so a small sleep is the pragmatic option here.
sleep 3

# The /sessions endpoint returns 200 with any valid bearer + JSON body
# (may be empty [] on a fresh cluster; may contain a "default" bootstrap
# session — either shape is fine, we just need proof-of-life).
#
# Bounded retry: the first attempt can race the port-forward's
# pod-side stream (kubectl accepts the local connection before the
# endpoint is dialable → curl exits 52 "empty reply"), especially on
# a machine still hot from the docker build. Observed ~1-in-2 on a
# loaded runner; one retry has always sufficed, five is margin.
probe_ok=""
for attempt in 1 2 3 4 5; do
    if resp="$(curl -sS --max-time 5 \
        -H "Authorization: Bearer $SRE_TOKEN" \
        -o "$SCRATCH_DIR/sessions.json" \
        -w '%{http_code}' \
        http://127.0.0.1:7777/sessions 2>&1)"; then
        probe_ok=1
        break
    fi
    echo "e2e: attach probe attempt $attempt failed ($resp); retrying" >&2
    sleep 3
done
if [[ -z "$probe_ok" ]]; then
    echo "e2e: attach listener probe failed after 5 attempts: $resp" >&2
    exit 1
fi
if [[ "$resp" != "200" ]]; then
    echo "e2e: attach listener returned HTTP $resp (expected 200)" >&2
    cat "$SCRATCH_DIR/sessions.json" 2>&1 | head -20 >&2
    exit 1
fi
# Parse just to make sure it's valid JSON.
if ! jq -e '.sessions' "$SCRATCH_DIR/sessions.json" >/dev/null 2>&1; then
    echo "e2e: /sessions response not shaped like {sessions: [...]}" >&2
    cat "$SCRATCH_DIR/sessions.json" >&2
    exit 1
fi

# --- phase 7: log-fingerprint assertions ------------------------------

echo "▸ verify daemon startup fingerprint"
LOG="$(kubectl -n "$NAMESPACE" logs deployment/core-agent --tail=200 2>&1)"

# Required lines — any missing = something is broken at startup.
# Note: `grep -- "$pat"` (double-dash sentinel) is required to let
# patterns starting with `--` through without grep treating them as
# option flags.
required_patterns=(
    "pricing refresh:"
    "attach listener on 0.0.0.0:7777"
    "session db:"
    # The MCP summary line always prints (any outcome). gke(failed)
    # is EXPECTED here — the GKE MCP endpoint isn't reachable from
    # kind and phase 9's echo-provider pipeline never calls it. What
    # this asserts is that the loader ran and accounted for the one
    # configured server rather than silently skipping mcp.json.
    "mcp: 1 server(s) loaded"
)
for pat in "${required_patterns[@]}"; do
    if ! echo "$LOG" | grep -qF -- "$pat"; then
        echo "e2e: daemon log missing expected line: $pat" >&2
        echo "--- daemon log ---" >&2
        echo "$LOG" >&2
        exit 1
    fi
done

# Forbidden lines — any present = latent issue we should catch.
# 'instruction: no AGENTS.md found' assertion depends on issue #218
# landing (adds the diagnostic); once it does, uncomment the line.
# "core-agent: mcp:" is no longer forbidden: since 2.6.0 the daemon
# ALWAYS prints an informational "core-agent: mcp: N server(s)
# loaded" summary, and in kind the gke server's failure is expected
# (asserted as a required pattern above instead).
forbidden_patterns=(
    "permission denied"
    "fatal"
    "panic"
    # "instruction: no AGENTS.md found"  # enable after #218 merges
)
for pat in "${forbidden_patterns[@]}"; do
    if echo "$LOG" | grep -iqF -- "$pat"; then
        echo "e2e: daemon log contains forbidden pattern: $pat" >&2
        echo "--- daemon log (matching lines) ---" >&2
        echo "$LOG" | grep -iF -- "$pat" >&2
        exit 1
    fi
done

# --- phase 8: sanity-check what actually landed in the cluster --------

echo "▸ verify ConfigMap + Secret presence in $NAMESPACE"
kubectl -n "$NAMESPACE" get cm core-agent-agents core-agent-gcp-env >/dev/null
kubectl -n "$NAMESPACE" get secret core-agent-users k8s-event-watcher-token >/dev/null

# Confirm the ConfigMaps landed in the RIGHT namespace (namespace-
# regression bug #6baae3c would put them in `default`).
if kubectl -n default get cm core-agent-agents >/dev/null 2>&1; then
    echo "e2e: core-agent-agents ConfigMap leaked into default namespace" >&2
    exit 1
fi

# --- phase 9: pipeline assertion (event → lookout → inject → turn) -----

# Prove the pipeline FLOWS, hermetically: a broken pod fires Warning
# events; the nonexistent image produces reason=Failed (NOT in
# lookout's default reason allow-list — filtered) and reason=BackOff
# ("Back-off pulling image", which IS in the allow-list, see
# k8s-lookout pkg/engine/filter.go defaultReasons). lookout is running
# with --mode=per-incident, so on first BackOff it POSTs /sessions
# (asserting X-Asserted-Caller=--owner, allowed because users.json's
# sa:k8s-event-watcher is in the recipe's proxy_identities) and then
# POSTs the incident payload to /sessions/<sid>/inject. The daemon's
# wake loop drains the inject into one echo-provider turn, so the
# session's eventlog ends up with a user event carrying the payload
# AND a model event mirroring it back.
echo "▸ pipeline: create broken-image pod (BackOff event source)"
SCRATCH_NS="e2e-pipeline"
BROKEN_POD="broken-image-pod"
kubectl create namespace "$SCRATCH_NS"
# Nonexistent image → no bytes pulled, fails fast, fully hermetic.
kubectl -n "$SCRATCH_NS" run "$BROKEN_POD" \
    --image=ghcr.io/go-steer/definitely-not-a-real-image:v0 \
    --restart=Never

# (a) Watcher-side evidence. lookout logs exactly one line per
# successful inject:
#   fire <reason> pod=<ns>/<name> → sid=<sessionID> (mode=per-incident)
# which both proves accept+inject AND hands us the session ID for the
# daemon-side check. One shared deadline covers the whole pipeline.
echo "▸ pipeline: wait for lookout accept + inject (${PIPELINE_TIMEOUT}s max)"
pipeline_deadline=$(( SECONDS + PIPELINE_TIMEOUT ))
SID=""
while (( SECONDS < pipeline_deadline )); do
    # `|| true` inside the substitution: a transient kubectl failure
    # (pod restarting, apiserver blip) must count as "not found yet"
    # and retry — under set -euo pipefail it otherwise kills the
    # whole run mid-poll (#488).
    SID="$(kubectl -n "$NAMESPACE" logs deployment/k8s-event-watcher --tail=300 2>/dev/null \
        | sed -n "s|.*fire BackOff pod=${SCRATCH_NS}/${BROKEN_POD} → sid=\([^ ]*\).*|\1|p" \
        | tail -1 || true)"
    [[ -n "$SID" ]] && break
    sleep 5
done
if [[ -z "$SID" ]]; then
    echo "e2e: lookout never logged an inject for ${SCRATCH_NS}/${BROKEN_POD} within ${PIPELINE_TIMEOUT}s" >&2
    echo "--- scratch-namespace events ---" >&2
    kubectl -n "$SCRATCH_NS" get events --sort-by='.lastTimestamp' 2>&1 | tail -10 >&2
    echo "--- watcher logs ---" >&2
    kubectl -n "$NAMESPACE" logs deployment/k8s-event-watcher --tail=50 >&2 2>&1 || true
    exit 1
fi
echo "  lookout fired: sid=$SID"

# Cross-check the watcher's own counter (the DEMO.md troubleshooting
# metric): filter+dedup survivors that were POSTed to the daemon.
echo "▸ pipeline: verify watcher injected counter (:9090 metrics)"
kubectl -n "$NAMESPACE" port-forward deployment/k8s-event-watcher \
    19090:9090 >/dev/null 2>&1 &
PF2_PID=$!
sleep 3
if ! curl -sS --max-time 5 http://127.0.0.1:19090/metrics 2>/dev/null \
    | grep 'k8s_event_watcher_events_injected_total' \
    | grep -q 'reason="BackOff"'; then
    echo "e2e: watcher metrics missing events_injected_total{reason=\"BackOff\"}" >&2
    curl -sS --max-time 5 http://127.0.0.1:19090/metrics 2>/dev/null \
        | grep 'k8s_event_watcher' | head -20 >&2 || true
    exit 1
fi
kill "$PF2_PID" 2>/dev/null || true
PF2_PID=""

# (b) Daemon-side evidence, via the still-forwarded attach listener.
# Per-incident sessions are created with X-Asserted-Caller=--owner
# (sre-oncall@example.com), so SRE_TOKEN — the owner — can see them.
echo "▸ pipeline: verify incident session is listed by the daemon"
# Retry-tolerant like the SID poll above: a port-forward blip on one
# curl must not abort the run under set -e (#488); only the deadline
# expiring is a verdict.
sessions_deadline=$(( SECONDS + 30 ))
session_listed="no"
while (( SECONDS < sessions_deadline )); do
    curl -sS --max-time 5 -H "Authorization: Bearer $SRE_TOKEN" \
        -o "$SCRATCH_DIR/sessions-after.json" \
        http://127.0.0.1:7777/sessions || true
    if jq -e --arg sid "$SID" \
        '.sessions | map(select(.sessionID == $sid)) | length >= 1' \
        "$SCRATCH_DIR/sessions-after.json" >/dev/null 2>&1; then
        session_listed="yes"
        break
    fi
    sleep 3
done
if [[ "$session_listed" != "yes" ]]; then
    echo "e2e: incident session $SID missing from /sessions" >&2
    cat "$SCRATCH_DIR/sessions-after.json" >&2 || true
    exit 1
fi

# The eventlog must show the incident payload arriving as a user
# event AND an echo model response following it (proof the wake loop
# actually ran a turn — echo mirrors the last user text, so the model
# event carries the broken pod's name too). /events is SSE with a
# full replay at since=0; --max-time bounds the then-idle stream, so
# curl exiting 28 is expected and we keep whatever replayed.
echo "▸ pipeline: verify inject + echo turn in session eventlog"
verdict="pending"
events_deadline=$(( pipeline_deadline > SECONDS + 30 ? pipeline_deadline : SECONDS + 30 ))
while (( SECONDS < events_deadline )); do
    curl -sS -N --max-time 8 -H "Authorization: Bearer $SRE_TOKEN" \
        "http://127.0.0.1:7777/sessions/$SID/events?since=0" \
        > "$SCRATCH_DIR/pipeline-events.sse" 2>/dev/null || true
    verdict="$(sed -n 's/^data: //p' "$SCRATCH_DIR/pipeline-events.sse" \
        | jq -rs --arg pod "$BROKEN_POD" '
            [ .[] | objects | .seq as $seq
                  | (.event? // empty) | objects
                  | (.Content? // empty) | objects
                  | select(((.parts // []) | map(.text // "") | join(" "))
                           | contains($pod))
                  | {seq: $seq, role: (.role // "")} ] as $hits
            | ([$hits[] | select(.role == "user")  | .seq] | min) as $u
            | ([$hits[] | select(.role == "model") | .seq] | min) as $m
            | if $u != null and $m != null and $m > $u
              then "ok" else "pending" end' 2>/dev/null || echo pending)"
    [[ "$verdict" == "ok" ]] && break
    sleep 5
done
if [[ "$verdict" != "ok" ]]; then
    echo "e2e: session $SID never showed user-inject + echo-model events for $BROKEN_POD" >&2
    echo "--- session $SID event frames (data lines, tail) ---" >&2
    sed -n 's/^data: //p' "$SCRATCH_DIR/pipeline-events.sse" | tail -20 >&2
    echo "--- /sessions ---" >&2
    cat "$SCRATCH_DIR/sessions-after.json" >&2
    echo "--- watcher logs ---" >&2
    kubectl -n "$NAMESPACE" logs deployment/k8s-event-watcher --tail=30 >&2 2>&1 || true
    exit 1
fi

echo ""
echo "✓ e2e: gke-troubleshoot-agent recipe deploys AND the pipeline flows"
echo "       (k8s event → lookout filter → authenticated inject → echo turn)"
