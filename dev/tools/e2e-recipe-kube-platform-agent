# Loader-only validation for the kube-platform-agent recipe (v2.9 Phase
# 0 / W5, epic #589).
#
# Unlike e2e-recipe-gke-troubleshoot-agent, this needs NO kind cluster,
# NO docker, and NO cloud credentials: it drives the same v2 loader the
# daemon uses (instruction @include chain, skills discovery, MCP + config
# parse) against the vendored snapshot and asserts it all resolves. The
# same test also runs as part of CI's test-unit presubmit (go test ./...);
# this wrapper is the discoverable, verbose, standalone entry point.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

exec go test -v -count=1 ./examples/kube-platform-agent/...
