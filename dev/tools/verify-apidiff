# Compare the exported API of every `promised` package in
# dev/api-surface.txt against the latest release tag using
# golang.org/x/exp/cmd/apidiff.
#
# An incompatible change fails the check unless Either:
#   - its `<package> <symbol>` is listed in dev/api-breaks.txt, or
#   - the ## [Unreleased] section of CHANGELOG.md contains a
#     `**BREAKING:**` bullet whose line names BOTH the package
#     (`pkg/foo` or `foo` in backticks) AND the symbol (`Bar`,
#     `Type.Method` or `foo.Bar` in backticks).
#
# Set APIDIFF_BASE_TAG to override the baseline tag (or APIDIFF_TAG_PATTERN
# to change the git-describe glob; defaults to v[1-9]*).
set -euo pipefail
. "$(dirname "$0")/common.sh"

# Pin matches golang.org/x/exp in go.mod.
APIDIFF_VERSION="${APIDIFF_VERSION:-v0.0.0-20260112195511-716be5621a96}"

ROOT="$(repo_root)"
cd "$ROOT"

SURFACE_FILE="dev/api-surface.txt"
BREAKS_FILE="dev/api-breaks.txt"
CHANGELOG_FILE="CHANGELOG.md"

if [[ ! -f "$SURFACE_FILE" ]]; then
  echo "FAIL: missing $SURFACE_FILE" >&2
  exit 1
fi

TAG_PATTERN="${APIDIFF_TAG_PATTERN:-v[1-9]*}"
BASE_TAG="${APIDIFF_BASE_TAG:-$(git describe --tags --abbrev=0 --match "$TAG_PATTERN" --exclude '*-*' 2>/dev/null || true)}"
if [[ -z "$BASE_TAG" ]]; then
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    echo "FAIL: no release tag matching '$TAG_PATTERN' reachable from HEAD in CI (ensure actions/checkout uses fetch-depth: 0)" >&2
    exit 1
  fi
  echo "verify-apidiff: no release tag matching '$TAG_PATTERN' reachable from HEAD; skipping."
  exit 0
fi

mapfile -t PROMISED < <(awk '$1 == "promised" { print $2 }' "$SURFACE_FILE")
if [[ ${#PROMISED[@]} -eq 0 ]]; then
  echo "FAIL: no 'promised' packages listed in $SURFACE_FILE" >&2
  exit 1
fi

ensure_tool apidiff "golang.org/x/exp/cmd/apidiff@${APIDIFF_VERSION}"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/core-agent-apidiff.XXXXXX")"
BASE_TREE="$WORK/base"
SNAP_DIR="$WORK/snaps"
mkdir -p "$BASE_TREE" "$SNAP_DIR"
cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT

git archive "$BASE_TAG" | tar -x -C "$BASE_TREE"

# Extract ## [Unreleased] plus any pre-release sections since BASE_TAG
# so promoting [Unreleased] to a dev/rc heading does not drop
# **BREAKING:** acknowledgements before the next GA tag is cut (#1427).
UNRELEASED=""
BASE_VERSION="${BASE_TAG#v}"
if [[ -f "$CHANGELOG_FILE" ]]; then
  UNRELEASED="$(awk -v base="$BASE_VERSION" '
    /^## \[Unreleased\]/ { in_unrel = 1; next }
    /^## \[/ && in_unrel {
      if ($0 ~ "^## \\[" base "\\]" || $0 ~ "^## \\[[0-9]+\\.[0-9]+\\.[0-9]+\\]") {
        exit
      }
    }
    in_unrel { print }
  ' "$CHANGELOG_FILE")"
fi

ack_in_breaks_file() {
  local pkg="$1" sym="$2"
  [[ -f "$BREAKS_FILE" ]] || return 1
  awk -v pkg="$pkg" -v sym="$sym" '
    {
      sub(/#.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ($1 == pkg && ($2 == sym || $2 == "*")) { found = 1; exit }
    }
    END { exit (found ? 0 : 1) }
  ' "$BREAKS_FILE"
}

ack_in_changelog() {
  local pkg="$1" sym="$2"
  local short_pkg="${pkg#pkg/}"
  local clean_sym="${sym#(\*}"
  clean_sym="${clean_sym/\)./.}"
  local head_sym="${clean_sym%%.*}"
  [[ -n "$UNRELEASED" ]] || return 1
  # One **BREAKING:** bullet acknowledges one break: the SAME line must
  # name the package (backticked path, or backticked short name) AND the
  # symbol in backticks. Substring matches on bare words were too loose —
  # `config.` matched any bullet mentioning config.json, `agent.` matched
  # "core-agent." at a sentence end, and a head symbol like `New` or
  # `Agent` matched prose — so one bullet quietly acknowledged every
  # later break in the package (#1421 review).
  local line
  while IFS= read -r line; do
    grep -Fq -e "\`$pkg\`" -e "\`$short_pkg\`" -e "\`${short_pkg}." <<<"$line" || continue
    if [[ "$sym" == "$pkg" ]]; then
      return 0 # whole-package removal: naming the package is the ack
    fi
    grep -Fq -e "\`$clean_sym\`" -e "\`${short_pkg}.${clean_sym}\`" -e "\`${head_sym}\`" -e "\`${short_pkg}.${head_sym}\`" <<<"$line" && return 0
  done < <(grep -E '^[[:space:]]*-[[:space:]]+\*\*BREAKING:\*\*' <<<"$UNRELEASED")
  return 1
}

# is_compatible_type_alias_move returns 0 when an apidiff incompatibility line
# is solely a non-breaking type-alias move from pkg/attach to pkg/attach/wire
# (#1372, #1415), where:
#   1. The line has the form `<sym>: changed from <old> to <new>`.
#   2. Replacing `/pkg/attach/wire.` with `/pkg/attach.` in <new> yields <old>
#      exactly.
#   3. Every `<Type>` referenced as `/pkg/attach/wire.<Type>` in <new> is
#      re-exported as a type alias (`<Type> = wire.<Type>`) in pkg/attach/wire.go.
is_compatible_type_alias_move() {
  local line="$1"
  [[ "$line" == *": changed from "*" to "* ]] || return 1
  local rest="${line#*: changed from }"
  local old_sig="${rest%% to *}"
  local new_sig="${rest#* to }"
  [[ "$old_sig" != "$new_sig" ]] || return 1
  local mapped="${new_sig//\/pkg\/attach\/wire./\/pkg\/attach.}"
  [[ "$mapped" == "$old_sig" ]] || return 1
  [[ -f "$ROOT/pkg/attach/wire.go" ]] || return 1
  local t
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    grep -Eq "^[[:space:]]*(type[[:space:]]+)?${t}[[:space:]]*=[[:space:]]*wire\.${t}([[:space:]]|$)" "$ROOT/pkg/attach/wire.go" || return 1
  done < <(grep -oE '/pkg/attach/wire\.[A-Za-z0-9_]+' <<<"$new_sig" | sed 's|^/pkg/attach/wire\.||' | sort -u)
  return 0
}

unacked=()
checked=0

for pkg in "${PROMISED[@]}"; do
  base_pkg="$pkg"
  filter_unmoved_attach=0
  if ! compgen -G "$BASE_TREE/$pkg/*.go" >/dev/null; then
    # pkg/attach/wire was extracted from pkg/attach after v3.1.0 (#1372);
    # diff its symbols against BASE_TAG's pkg/attach so any incompatible
    # change to a moved wire type is still caught before v3.2.0 is tagged.
    if [[ "$pkg" == "pkg/attach/wire" ]] && compgen -G "$BASE_TREE/pkg/attach/*.go" >/dev/null; then
      base_pkg="pkg/attach"
      filter_unmoved_attach=1
    else
      # Package added after BASE_TAG — no baseline to break.
      continue
    fi
  fi
  if ! compgen -G "$ROOT/$pkg/*.go" >/dev/null; then
    if ack_in_breaks_file "$pkg" "*" || ack_in_changelog "$pkg" "$pkg"; then
      echo "verify-apidiff: acknowledged removal of promised package $pkg"
      continue
    fi
    unacked+=("$pkg: promised package directory removed since $BASE_TAG")
    continue
  fi

  snap="$SNAP_DIR/$(tr '/' '_' <<<"$pkg").api"
  (cd "$BASE_TREE" && apidiff -w "$snap" "./$base_pkg")
  diff_out="$(apidiff "$snap" "./$pkg")"
  attach_incompat=""
  if [[ "$filter_unmoved_attach" -eq 1 ]]; then
    attach_diff="$(apidiff "$snap" "./pkg/attach")"
    attach_incompat="$(awk '
      /^Incompatible changes:/ { inc = 1; next }
      /^Compatible changes:/   { inc = 0; next }
      inc && /^[[:space:]]*-[[:space:]]+/ {
        sub(/^[[:space:]]*-[[:space:]]+/, "")
        print
      }
    ' <<<"$attach_diff")"
  fi
  checked=$((checked + 1))

  [[ -z "$diff_out" ]] && continue

  # Extract lines under the "Incompatible changes:" header.
  incompat="$(awk '
    /^Incompatible changes:/ { inc = 1; next }
    /^Compatible changes:/   { inc = 0; next }
    inc && /^[[:space:]]*-[[:space:]]+/ {
      sub(/^[[:space:]]*-[[:space:]]+/, "")
      print
    }
  ' <<<"$diff_out")"

  [[ -z "$incompat" ]] && continue

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    sym="${line%%:*}"
    sym="${sym%% *}"
    if [[ "$filter_unmoved_attach" -eq 1 && "$line" == "${sym}: removed" ]]; then
      # Server-only symbol that stayed in pkg/attach rather than moving to
      # pkg/attach/wire: verify apidiff against ./pkg/attach itself does NOT
      # report it removed (package-level export check via go/types, never
      # matching struct fields) and that it is not a wire alias in wire.go.
      if ! grep -Fxq "$line" <<<"$attach_incompat" && \
         ! grep -Eq "^[[:space:]]*((type|var|const)[[:space:]]+)?${sym}[[:space:]]*=[[:space:]]*wire\.${sym}([[:space:]]|$)" "$ROOT/pkg/attach/wire.go"; then
        continue
      fi
    fi
    if is_compatible_type_alias_move "$line"; then
      continue
    fi
    if ack_in_breaks_file "$pkg" "$sym" || ack_in_changelog "$pkg" "$sym"; then
      echo "verify-apidiff: acknowledged break in $pkg: $line"
    else
      unacked+=("$pkg: $line")
    fi
  done <<<"$incompat"
done

if [[ ${#unacked[@]} -gt 0 ]]; then
  echo "FAIL: unacknowledged incompatible API changes vs $BASE_TAG:" >&2
  for item in "${unacked[@]}"; do
    echo "  - $item" >&2
  done
  echo "" >&2
  echo "Either restore compatibility, record the break in $BREAKS_FILE," >&2
  echo "or add a **BREAKING:** bullet under ## [Unreleased] in $CHANGELOG_FILE." >&2
  echo "See docs/compatibility-policy.md." >&2
  exit 1
fi

echo "verify-apidiff: $checked promised package(s) compatible with $BASE_TAG."
