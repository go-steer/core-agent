# Verifies that every exported interface in github.com/go-steer/core-vcs/vcs
# and every provider package under github.com/go-steer/core-vcs/providers/*
# at the version go.mod pins is accounted for by a compile-time `var _` guard
# in pkg/tools/vcs/guards.go (#1490, docs/gitops-vcs-design.md decision 11).
#
# Modes:
#
#   verify-core-vcs-pin           # verify (this is what CI runs)
#   verify-core-vcs-pin --print   # dump the interface + provider guard table

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

exec go run ./dev/corevcs-pin-check "$@"
