# Check the GKE drill without a cluster.
#
#   selftest.sh   the parts: shell + Python syntax, the scenario
#                 contract, the fixture YAML, score.py against two
#                 recorded transcripts
#   dryrun.sh     the whole thing: drill.sh driven end to end against a
#                 fake kubectl, curl and gcloud
#
# The drill is the instrument v2.9 is measured with, and until now
# nothing checked it on a PR. A regression in it does not show up as a
# red build, it shows up as a wasted cluster day — which is the scarcest
# thing this project has.
#
# Needs bash, jq and python3. No credentials, no network, no cluster.
set -euo pipefail

ROOT=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )/../.." &> /dev/null && pwd )
DRILL="${ROOT}/dev/uat/gke-drill"

for t in jq python3; do
    command -v "${t}" >/dev/null 2>&1 || {
        echo "✗ ${t} is not on PATH — verify-gke-drill needs jq and python3." >&2
        exit 1
    }
done

"${DRILL}/selftest.sh"
"${DRILL}/dryrun.sh"
