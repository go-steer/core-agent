# The checks that keep every consumer of "which Go toolchain does this
# project build with" honest. The answer itself comes from
# common.sh's resolve_toolchain, which prefers go.mod's `toolchain`
# directive over its `go` directive — see the comment there for why the
# distinction decides whether a shipped binary is vulnerable, and for
# why the `go`-directive fallback is the branch we take today.
#
# Modes:
#
#   verify-go-toolchain              # static: everything agrees with go.mod
#                                    # (runs --self-test first)
#   verify-go-toolchain --print      # emit the version (e.g. 1.26.6)
#   verify-go-toolchain --running    # the go on PATH IS that toolchain
#   verify-go-toolchain --binary P   # a built binary carries that toolchain,
#                                    # and its stdlib has no advisories
#   verify-go-toolchain --self-test  # resolve_toolchain itself, on fixtures

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# Dockerfiles whose `ARG GO_VERSION=` default must track go.mod. The
# default only applies to a local `docker build` with no --build-arg —
# the release workflow passes the version explicitly — but a stale
# default silently hands a contributor a months-old compiler.
DOCKERFILES=(Dockerfile extras/scion/Dockerfile)

# Every workflow gets its Go through this composite action, which
# resolves the version through THIS script and then verifies what it
# actually installed. A workflow reaching for actions/setup-go directly
# is how a floating version gets back in: the release workflow used to
# grep go.mod inline and read the `go` directive, publishing images
# built on the compatibility floor (#736), and CI used to ask for the
# newest 1.26.x on purpose, which scans a stdlib we never ship.
GO_ACTION=.github/actions/go-toolchain/action.yml
GO_ACTION_REF=./.github/actions/go-toolchain

usage() {
  cat <<'EOF'
Usage: dev/tools/verify-go-toolchain [--print | --running | --binary <path>]

  (no flags)        verify go.mod, the Dockerfiles, and the workflows
                    all agree on the Go toolchain (runs --self-test too)
  --print           print the toolchain version (e.g. 1.26.6)
  --running         verify the go command on PATH reports that toolchain
  --binary <path>   verify a built binary was compiled with that
                    toolchain and carries no stdlib advisories
  --self-test       exercise resolve_toolchain against fixture go.mod
                    files, including the `go`-directive fallback
EOF
}

# Self-test: resolve_toolchain against fixture go.mod files.
#
# The rest of this script trusts resolve_toolchain to answer "which Go do
# we ship". Nothing checked resolve_toolchain, and its two branches are
# mutually exclusive, so whichever one the repo's own go.mod does not
# take has zero coverage — which is exactly how the fallback branch sat
# broken under `set -euo pipefail` from the day it was written until the
# day go.mod first needed it (a grep that matches nothing fails the
# pipeline, and the failing assignment aborted the function under
# errexit). Fixtures make both branches reachable regardless of what the
# repo's go.mod happens to look like this week.
self_test() {
  local tmp failed=0
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand $tmp now, not at trap time
  trap "rm -rf '$tmp'" RETURN

  printf 'module x\n\ngo 1.26.4\n\ntoolchain go1.26.6\n' > "$tmp/both.mod"
  printf 'module x\n\ngo 1.26.6\n'                        > "$tmp/gonly.mod"
  printf 'module x\n'                                     > "$tmp/neither.mod"

  local got
  # The toolchain directive wins when both are present. This is #736's
  # whole property: the `go` directive is the compatibility floor.
  got="$(resolve_toolchain "$tmp/both.mod")"
  if [[ "$got" != "1.26.6" ]]; then
    echo "self-test: both directives -> got '${got}', want '1.26.6'" >&2
    failed=1
  fi

  # The fallback branch, as a plain statement rather than a command
  # substitution. Every call site today happens to launder errexit away
  # (`$(...)` subshells, `|| return 1`), which is the only reason the
  # broken version stayed invisible; `resolve_toolchain > file` is the
  # form dev/README.md advertises and the form that used to abort.
  local rc=0
  bash -c '
    set -euo pipefail
    . "$1"
    resolve_toolchain "$2" > "$3"
  ' _ "$(dirname "$0")/common.sh" "$tmp/gonly.mod" "$tmp/out" 2>/dev/null || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "self-test: go-directive fallback aborted (exit ${rc})" >&2
    failed=1
  elif [[ "$(cat "$tmp/out" 2>/dev/null || true)" != "1.26.6" ]]; then
    echo "self-test: go-directive fallback -> got '$(cat "$tmp/out" 2>/dev/null || true)', want '1.26.6'" >&2
    failed=1
  fi

  # Same fallback under `shopt -s inherit_errexit`, which propagates
  # errexit into command substitutions and so re-exposes the bug at
  # every call site that currently launders it.
  got="$(bash -c '
    set -euo pipefail
    shopt -s inherit_errexit
    . "$1"
    resolve_toolchain "$2"
  ' _ "$(dirname "$0")/common.sh" "$tmp/gonly.mod" 2>/dev/null || true)"
  if [[ "$got" != "1.26.6" ]]; then
    echo "self-test: fallback under inherit_errexit -> got '${got}', want '1.26.6'" >&2
    failed=1
  fi

  # Neither directive is a hard error, not a silent empty string: an
  # empty version would sail through as GOTOOLCHAIN=go and compare
  # unequal to every real version downstream.
  if resolve_toolchain "$tmp/neither.mod" >/dev/null 2>&1; then
    echo "self-test: go.mod with no directives should have failed" >&2
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi
  echo "verify-go-toolchain: OK (resolve_toolchain self-test)"
}

# Static check: every place that names a Go version agrees with go.mod.
verify_static() {
  local expected="$1"
  local failed=0

  local dockerfile actual
  for dockerfile in "${DOCKERFILES[@]}"; do
    actual=$(grep -oE '^ARG GO_VERSION=[^ ]+$' "$dockerfile" \
             | sed -n '1p' | sed 's/^ARG GO_VERSION=//')
    if [[ -z "$actual" ]]; then
      echo "verify-go-toolchain: ${dockerfile} has no 'ARG GO_VERSION=' default" >&2
      failed=1
      continue
    fi
    if [[ "$actual" != "$expected" ]]; then
      cat >&2 <<EOF
verify-go-toolchain: ${dockerfile} builds on a different Go than go.mod.

  go.mod toolchain:  ${expected}
  ARG GO_VERSION:    ${actual}

Fix the Dockerfile default:
  ARG GO_VERSION=${expected}
EOF
      failed=1
    fi
  done

  local missing
  for missing in 'verify-go-toolchain --print' 'verify-go-toolchain --running'; do
    if ! grep -q -- "$missing" "$GO_ACTION"; then
      cat >&2 <<EOF
verify-go-toolchain: ${GO_ACTION} no longer runs
\`dev/tools/${missing}\`.

That action is what makes "CI builds what we ship" checkable rather
than assumed: --print resolves the version through resolve_toolchain,
which prefers the \`toolchain\` directive over the \`go\` compatibility
floor (reading the floor is how #736 happened), and --running confirms
the job got what it asked for.
EOF
      failed=1
    fi
  done

  # Grep, not a YAML parse: this check runs in its own workflow with no
  # Go and no Python guaranteed, and "does the string appear" is the
  # whole question.
  local offenders
  offenders=$(grep -rln 'uses:[[:space:]]*actions/setup-go' .github/workflows || true)
  if [[ -n "$offenders" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: these workflows call actions/setup-go directly:

$(echo "$offenders" | sed 's|^|  |')

Use the composite action instead, so the version comes from go.mod's
toolchain directive and is verified after install:

  - uses: ${GO_ACTION_REF}

A bare setup-go with a floating \`go-version\` is what let source-mode
govulncheck pass against a stdlib newer than the one we ship.
EOF
    failed=1
  fi

  # `^go ` anchored against go.mod is the signature of reading the
  # compatibility floor. Both instances found so far — release.yml's
  # awk over the `go` directive and the kind E2E's `grep -E '^go
  # [0-9]...'` — built artifacts one patch behind what we ship.
  # resolve_toolchain is the only place that pattern belongs; this file
  # is excluded because the pattern it greps for is itself the pattern.
  offenders=$(grep -rln -- '\^go \[0-9\]\|/\^go /' dev .github \
              | grep -vE '^(dev/tools/common.sh|dev/tools/verify-go-toolchain)$' || true)
  if [[ -n "$offenders" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: these files parse go.mod's \`go\` directive inline:

$(echo "$offenders" | sed 's|^|  |')

That is the language compatibility floor, not the toolchain we build
with — reading it is how #736 shipped images with a stdlib CI had
already moved off. Shell callers should use resolve_toolchain (from
dev/tools/common.sh); workflows should use ${GO_ACTION_REF}.
EOF
    failed=1
  fi

  offenders=$(grep -rln '^\s*GO_VERSION:' .github/workflows || true)
  if [[ -n "$offenders" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: these workflows still define a GO_VERSION env:

$(echo "$offenders" | sed 's|^|  |')

There is one source of truth for the Go version and it is go.mod. Read
it with ${GO_ACTION_REF} (its \`version\` output carries the resolved
value for build-args and the like).
EOF
    failed=1
  fi

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi
  echo "verify-go-toolchain: OK (go${expected} everywhere)"
}

# Running check: the toolchain this job will actually invoke.
#
# The static check compares strings in files; this one asks the go
# command. It is the answer that matters for anything that reports
# against the standard library — source-mode govulncheck above all,
# which judges stdlib advisories by the version of the toolchain
# running it, not by anything in go.mod.
#
# Note that common.sh has already exported GOTOOLCHAIN, so a mismatch
# here is not "your Go is old" — it means something overrode the pin, or
# the go command failed to honor it.
verify_running() {
  local expected="$1"

  if ! command -v go >/dev/null 2>&1; then
    echo "verify-go-toolchain: no go command on PATH" >&2
    return 1
  fi

  local actual
  actual=$(go env GOVERSION | sed 's/^go//')
  if [[ "$actual" != "$expected" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: the go command on PATH is not the pinned toolchain.

  go.mod toolchain:  ${expected}
  go env GOVERSION:  ${actual}
  GOTOOLCHAIN:       ${GOTOOLCHAIN:-<unset>}

Anything this job reports about the standard library would be about a
stdlib we do not ship. If ${actual} is what we should be shipping, set
\`toolchain go${actual}\` in go.mod — adding the line if it isn't there,
which it won't be while it would only repeat the \`go\` directive — and
let the Dockerfile check tell you what else follows.
EOF
    return 1
  fi

  echo "verify-go-toolchain: OK (running go${actual})"
}

# Binary check: what actually got compiled, not what we asked for.
verify_binary() {
  local expected="$1"
  local binary="$2"

  if [[ ! -f "$binary" ]]; then
    echo "verify-go-toolchain: no such binary: ${binary}" >&2
    return 1
  fi

  # `go version <bin>` prints one line: "<path>: go1.26.6". (The -m
  # form dumps the whole module table, and `head -1` on that many lines
  # SIGPIPEs the go command under `set -o pipefail`.)
  local actual
  actual=$(go version "$binary" | awk '{print $2}' | sed 's/^go//')
  if [[ "$actual" != "$expected" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: ${binary} was built with the wrong Go.

  go.mod toolchain:  ${expected}
  binary reports:    ${actual}

The builder image is the usual culprit — check the GO_VERSION build-arg
reaching the Dockerfile. The official golang images set
GOTOOLCHAIN=local, so go.mod's toolchain directive will NOT rescue a
build that starts from the wrong base image.
EOF
    return 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    echo "verify-go-toolchain: jq is required for the stdlib scan" >&2
    return 1
  fi
  ensure_tool govulncheck golang.org/x/vuln/cmd/govulncheck@latest

  # Scan the artifact, not the source tree. Binary mode is coarser than
  # source mode — no call-graph reachability — so it over-reports for
  # third-party modules (today: 15 x/crypto + x/net findings that source
  # mode correctly rules unreachable). Filter to stdlib, which is the
  # class this check exists for and the one binary mode judges exactly:
  # the stdlib version comes from the binary's own build info.
  #
  # JSON mode exits 0 even when it finds something, so a non-zero exit
  # here is a real failure (bad path, no vuln database, ...).
  local report stdlib_findings
  report=$(govulncheck -format=json -mode=binary "$binary")
  stdlib_findings=$(echo "$report" | jq -rs \
    '[.[] | select(.finding) | .finding
       | select([.trace[]?.module] | index("stdlib")) | .osv]
     | unique | .[]')

  if [[ -n "$stdlib_findings" ]]; then
    cat >&2 <<EOF
verify-go-toolchain: go${expected} ships stdlib advisories:

$(echo "$stdlib_findings" | sed 's|^|  https://pkg.go.dev/vuln/|')

Set \`toolchain go<patch>\` in go.mod to the current patch release and
re-run — add the line if go.mod has none, which is the tidy'd shape
whenever the toolchain would only repeat the \`go\` directive. A real
patch bump is ahead of that floor, so \`go mod tidy\` keeps it.
Source-mode govulncheck (dev/tools/verify-vuln) scans with the
toolchain on PATH, which common.sh and the go-toolchain composite action
now pin to this same version — so the two checks agree, and neither one
is reporting about a stdlib nobody ships.
EOF
    return 1
  fi

  echo "verify-go-toolchain: OK (${binary} built with go${expected}, no stdlib advisories)"
}

main() {
  local mode=static binary=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print)     mode=print; shift ;;
      --running)   mode=running; shift ;;
      --binary)    mode=binary; binary="${2:-}"; shift 2 ;;
      --self-test) mode=self-test; shift ;;
      -h|--help) usage; exit 0 ;;
      *) echo "Unknown flag: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  if [[ "$mode" == self-test ]]; then
    self_test
    return
  fi

  local expected
  expected=$(resolve_toolchain)

  case "$mode" in
    print)   echo "$expected" ;;
    running) verify_running "$expected" ;;
    static)  self_test && verify_static "$expected" ;;
    binary)
      if [[ -z "$binary" ]]; then
        echo "verify-go-toolchain: --binary needs a path" >&2
        exit 2
      fi
      verify_binary "$expected" "$binary"
      ;;
  esac
}

main "$@"
