# Regression tests for dev/release/compose-release-notes.sh.
#
# Exists because v2.9.0-dev.4 shipped with an EMPTY release body: the
# composed notes came to 158,486 characters, GitHub rejects a body over
# 125,000 with a 422, and the workflow's populate step turned that into
# a published release carrying nothing. Tag, binaries and images were
# all fine, which is what made it easy to miss.
#
# Every case runs against a throwaway git repo under $TMPDIR rather than
# this checkout, so the assertions don't move when the real CHANGELOG or
# tag history does, and CI's shallow tagless checkout can't skew them.
# git-cliff is not required — the script degrades to a placeholder when
# it's absent, and none of these cases assert on the PR list's contents.

set -euo pipefail

COMPOSE="$(cd "$(dirname "$0")/../release" && pwd)/compose-release-notes.sh"
FOOTER="$(cd "$(dirname "$0")/../release" && pwd)/install-verify-footer.md.tmpl"
CUTGA="$(cd "$(dirname "$0")/../release" && pwd)/cut-ga-tag.sh"

FAILURES=0
CASE=""

fail() {
  echo "  FAIL: $*" >&2
  FAILURES=$((FAILURES + 1))
}

start_case() {
  CASE="$1"
  echo "• ${CASE}"
}

assert_contains() {
  local file="$1" needle="$2"
  if ! grep -qF -- "$needle" "$file"; then
    fail "expected to find '${needle}' in the body"
  fi
}

assert_absent() {
  local file="$1" needle="$2"
  if grep -qF -- "$needle" "$file"; then
    fail "expected NOT to find '${needle}' in the body"
  fi
}

assert_within() {
  local file="$1" limit="$2" size
  size="$(wc -c < "$file" | tr -d '[:space:]')"
  if [[ "$size" -gt "$limit" ]]; then
    fail "body is ${size} characters, over the ${limit} limit"
  fi
}

# A throwaway repo with two commits and two tags: v1.0.0 (stable, the
# range anchor) and v1.1.0-dev.1 (the pre-release under test).
REPO="$(mktemp -d)"
# A second repo whose most recent GA sits off the mainline — see case 8.
REPO2="$(mktemp -d)"
# A third for cut-ga-tag.sh, which edits CHANGELOG.md in place and needs
# it committed to have something to diff against — see case 11.
REPO3="$(mktemp -d)"
trap 'rm -rf "$REPO" "$REPO2" "$REPO3"' EXIT

init_repo() {
  local dir="$1"
  git init -q "$dir"
  git -C "$dir" config user.email release-test@example.com
  git -C "$dir" config user.name 'Release Test'
  git -C "$dir" config commit.gpgsign false
  git -C "$dir" config tag.gpgsign false
}

init_repo "$REPO"
: > "$REPO/f"
git -C "$REPO" add f
git -C "$REPO" commit -qm 'feat: the first thing'
git -C "$REPO" tag v1.0.0
echo x > "$REPO/f"
git -C "$REPO" commit -qam 'fix: the second thing'
git -C "$REPO" tag v1.1.0-dev.1

# $REPO2 reproduces this repo's real release topology: v1.1.0 is cut at
# the last dev tree rather than at the branch tip, the way v2.8.0 was cut
# at v2.8.0-dev.7 to keep un-UAT'd work out of the GA binary. The GA tag
# is therefore NOT an ancestor of the branch the next release is cut
# from, and any range anchor chosen by ancestry skips past it to v1.0.0.
init_repo "$REPO2"
: > "$REPO2/f"
git -C "$REPO2" add f
git -C "$REPO2" commit -qm 'feat: the first thing'
git -C "$REPO2" tag v1.0.0
echo x > "$REPO2/f"
git -C "$REPO2" commit -qam 'fix: the second thing'
git -C "$REPO2" checkout -q -b ga-tree
echo ga > "$REPO2/f"
git -C "$REPO2" commit -qam 'chore: the tree the GA was cut at'
git -C "$REPO2" tag v1.1.0
git -C "$REPO2" checkout -q -
echo y > "$REPO2/f"
git -C "$REPO2" commit -qam 'feat: the third thing'
git -C "$REPO2" tag v1.2.0-dev.1

# Marker strings. BREAKING and FILLER let each case say which sections
# survived degradation; FILLER stands in for `### Changes by Kind`, the
# 150,244-character bulk that actually blew the limit.
BREAKING='BREAKING_ENTRY_MARKER'
FILLER='FILLER_ENTRY_MARKER'
LEAD='LEAD_NARRATIVE_MARKER'
LINKOUT='the full detail stays in the CHANGELOG'
INSTALL='## Install'

# $1 = destination path, $2 = how many filler lines to pad with.
write_changelog() {
  local dest="$1" filler_lines="$2" i
  {
    printf '# Changelog\n\n'
    printf '## [1.1.0-dev.1]\n\n'
    printf '### Breaking Changes\n\n'
    printf -- '- **%s.** A short breaking note.\n\n' "$BREAKING"
    printf '### Changes by Kind\n\n'
    for ((i = 0; i < filler_lines; i++)); do
      printf -- '- %s %04d: %s\n' "$FILLER" "$i" \
        'padding that stands in for this repo long per-change prose.'
    done
    printf '\n## [1.0.0] — 2026-01-01\n\n- the first thing\n'
  } > "$dest"
}

compose() {
  local changelog="$1" notes="$2"
  ( cd "$REPO" && "$COMPOSE" v1.1.0-dev.1 "$notes" "$changelog" "$FOOTER" ) \
    2>"${notes}.err"
}

# ── 1. under the limit: nothing is shed ──────────────────────────────
start_case 'under the limit — full notes pass through untouched'
CL="$REPO/cl-small.md"; NOTES="$REPO/n1.md"
write_changelog "$CL" 5
compose "$CL" "$NOTES"
assert_contains "$NOTES" "$BREAKING"
assert_contains "$NOTES" "$FILLER"
assert_contains "$NOTES" "$INSTALL"
assert_absent "$NOTES" "$LINKOUT"

# ── 2. over the DEFAULT limit: this is the dev.4 failure ─────────────
# Deliberately not driven by MAX_BODY. The 125,000 default is the number
# GitHub actually enforces, and a case that only ever runs with an
# overridden limit would not have caught the release that prompted this.
start_case 'over the default 125,000 limit — degrades instead of 422-ing'
CL="$REPO/cl-huge.md"; NOTES="$REPO/n2.md"
write_changelog "$CL" 2000
compose "$CL" "$NOTES"
assert_within "$NOTES" 125000
assert_contains "$NOTES" "$LINKOUT"
assert_contains "$NOTES" "$BREAKING"
assert_absent "$NOTES" "$FILLER"
assert_contains "$NOTES" "$INSTALL"

# ── 3. Breaking Changes alone still overflows: shed it too ───────────
# A GA's notes are cumulative across every dev.N before it, so this is
# reachable without an override — hence a fixture that overflows on the
# real 125,000 rather than a lowered MAX_BODY.
start_case 'Breaking Changes alone too big — shed it, keep the link'
CL="$REPO/cl-huge-breaking.md"; NOTES="$REPO/n3.md"
{
  printf '# Changelog\n\n## [1.1.0-dev.1]\n\n### Breaking Changes\n\n'
  for ((i = 0; i < 2000; i++)); do
    printf -- '- **%s %04d.** %s\n' "$BREAKING" "$i" \
      'padding that stands in for this repo long per-change prose.'
  done
  printf '\n### Changes by Kind\n\n- %s 0000: padding.\n' "$FILLER"
  printf '\n## [1.0.0] — 2026-01-01\n\n- the first thing\n'
} > "$CL"
compose "$CL" "$NOTES"
assert_within "$NOTES" 125000
assert_contains "$NOTES" "$LINKOUT"
assert_absent "$NOTES" "$BREAKING"
assert_contains "$NOTES" "$INSTALL"

# ── 4. the floor: link plus footer, and it always fits ───────────────
# MAX_BODY=1 is unsatisfiable by construction, so this drives the guard
# all the way down and then off the end. Two things to prove: the body
# left on disk is the link-only form with the install footer intact, and
# that form is nowhere near the limit GitHub actually enforces — which
# is why the hard failure below it is unreachable in a real release.
start_case 'floor tier — link plus install footer, comfortably under 125,000'
NOTES="$REPO/n4.md"
if MAX_BODY=1 compose "$CL" "$NOTES"; then
  fail "expected a non-zero exit when the limit is unsatisfiable"
fi
assert_within "$NOTES" 125000
assert_contains "$NOTES" "$LINKOUT"
assert_contains "$NOTES" "$INSTALL"
assert_absent "$NOTES" '## Commits'
assert_absent "$NOTES" "$BREAKING"

# ── 5. a fenced `# comment` must not truncate Breaking Changes ───────
# The first cut of the subsection extractor exited on any line starting
# with `#`, which a shell snippet inside a ``` block satisfies. That
# silently dropped every breaking entry after the snippet.
start_case 'fenced hash comment does not truncate Breaking Changes'
CL="$REPO/cl-fence.md"; NOTES="$REPO/n5.md"
{
  printf '# Changelog\n\n## [1.1.0-dev.1]\n\n### Breaking Changes\n\n'
  printf -- '- **First entry.** Migration:\n\n'
  printf '```bash\n# a hash at column 0, inside a fence\ncore-agent --new-flag\n```\n\n'
  printf -- '- **%s.** Only survives if the fence was tracked.\n\n' "$BREAKING"
  printf '### Changes by Kind\n\n'
  for ((i = 0; i < 2000; i++)); do
    printf -- '- %s %04d: %s\n' "$FILLER" "$i" \
      'padding that stands in for this repo long per-change prose.'
  done
  printf '\n## [1.0.0] — 2026-01-01\n\n- the first thing\n'
} > "$CL"
compose "$CL" "$NOTES"
assert_contains "$NOTES" "$LINKOUT"
assert_contains "$NOTES" "$BREAKING"
assert_contains "$NOTES" 'core-agent --new-flag'
assert_absent "$NOTES" "$FILLER"

# ── 6. no promoted section: fall back to [Unreleased], keep Breaking ─
# A dev tag cut without promoting the CHANGELOG narrates from
# `## [Unreleased]`. The compact body has to re-read that same section,
# not `## [1.1.0-dev.1]`, or the degraded body loses Breaking Changes
# precisely when the operator most needs it.
start_case 'unpromoted CHANGELOG — compact body reads [Unreleased]'
CL="$REPO/cl-unreleased.md"; NOTES="$REPO/n6.md"
write_changelog "$CL" 2000
sed -i 's/^## \[1\.1\.0-dev\.1\]$/## [Unreleased]/' "$CL"
compose "$CL" "$NOTES"
assert_within "$NOTES" 125000
assert_contains "$NOTES" "$LINKOUT"
assert_contains "$NOTES" "$BREAKING"
assert_absent "$NOTES" "$FILLER"

# ── 7. the stable path still hard-fails on a missing section ─────────
# The guard must not have turned a genuine authoring mistake into a
# quietly-degraded body.
start_case 'stable tag with no CHANGELOG section still hard-fails'
CL="$REPO/cl-no-stable.md"; NOTES="$REPO/n7.md"
printf '# Changelog\n\n## [1.1.0-dev.1]\n\n- only a pre-release section\n' > "$CL"
if ( cd "$REPO" && "$COMPOSE" v1.0.0 "$NOTES" "$CL" "$FOOTER" ) >/dev/null 2>&1
then
  fail "expected a non-zero exit for a missing stable section"
fi

# ── 8. the range anchor is the previous version, not the previous ────
#      ancestor
# Caught by dry-running the v2.9.0 GA body: it came out headed "Commits
# since v2.7.0" and listed 375 commits instead of 225, because v2.8.0 was
# cut off-mainline and so failed `git tag --merged main`. Nothing about
# the body looked broken — it named a real tag and listed real commits —
# which is why an assertion has to hold the anchor rather than a reader.
start_case 'anchor is the newest stable version, even when it is not an ancestor'
CL="$REPO2/cl.md"; NOTES="$REPO2/n8.md"
printf '# Changelog\n\n## [Unreleased]\n\n### Changes by Kind\n\n- the third thing\n' > "$CL"
( cd "$REPO2" && "$COMPOSE" v1.2.0-dev.1 "$NOTES" "$CL" "$FOOTER" ) 2>"${NOTES}.err"
assert_contains "$NOTES" '## Commits since v1.1.0'
assert_absent "$NOTES" '## Commits since v1.0.0'
# The off-mainline GA's own commit is outside the range it anchors.
assert_absent "$NOTES" 'the tree the GA was cut at'

# ── 9. the section's lead narrative survives the first shed ──────────
# The v2.9.0 dry run is what added the lead to tier 2. Before it, a GA
# whose per-change notes overflowed opened cold on "the notes run past
# the limit, here is a link" — throwing away the hand-written paragraph
# that says what the release is *about*, to save 1,196 characters on an
# 18,000-character body against a 125,000 limit. Nothing failed; the
# page was just worse, which is exactly the kind of regression a reader
# waves through.
start_case 'compact body keeps the section lead alongside Breaking Changes'
CL="$REPO/cl-lead.md"; NOTES="$REPO/n9.md"
write_changelog "$CL" 2000
sed -i "s|^## \[1\.1\.0-dev\.1\]\$|## [1.1.0-dev.1]\n\n${LEAD} — what this release is about.|" "$CL"
compose "$CL" "$NOTES"
assert_within "$NOTES" 125000
assert_contains "$NOTES" "$LEAD"
assert_contains "$NOTES" "$BREAKING"
assert_absent "$NOTES" "$FILLER"
# …and it is shed with everything else at the floor, so the lead can
# never be the reason an unsatisfiable limit stays unsatisfied.
NOTES="$REPO/n9-floor.md"
if MAX_BODY=1 compose "$CL" "$NOTES"; then
  fail "expected a non-zero exit when the limit is unsatisfiable"
fi
assert_contains "$NOTES" "$LINKOUT"
assert_absent "$NOTES" "$LEAD"

# ── 10. an oversized lead is dropped, not trusted ────────────────────
# The lead is whatever an author wrote above the first `###`, so it is
# unbounded input to a body with a hard limit. Capped rather than
# trusted: a section that opens with an essay must not displace Breaking
# Changes or push the tier-2 floor over the limit.
start_case 'lead over MAX_LEAD is omitted with a warning, Breaking Changes kept'
CL="$REPO/cl-lead-huge.md"; NOTES="$REPO/n10.md"
{
  printf '# Changelog\n\n## [1.1.0-dev.1]\n\n'
  for ((i = 0; i < 200; i++)); do
    printf '%s %04d: an essay where a summary belongs.\n' "$LEAD" "$i"
  done
  printf '\n### Breaking Changes\n\n'
  printf -- '- **%s.** A short breaking note.\n\n' "$BREAKING"
  printf '### Changes by Kind\n\n'
  for ((i = 0; i < 2000; i++)); do
    printf -- '- %s %04d: %s\n' "$FILLER" "$i" \
      'padding that stands in for this repo long per-change prose.'
  done
  printf '\n## [1.0.0] — 2026-01-01\n\n- the first thing\n'
} > "$CL"
compose "$CL" "$NOTES"
assert_within "$NOTES" 125000
assert_absent "$NOTES" "$LEAD"
assert_contains "$NOTES" "$BREAKING"
assert_contains "${NOTES}.err" 'over MAX_LEAD'

# ── 11. the GA fold exits 0 and prints what to do next ───────────────
# The other ten cases are compose-release-notes.sh's. This one is
# cut-ga-tag.sh's, and it lives here because the two scripts are one
# pipeline: cut-ga-tag.sh writes the CHANGELOG section that
# compose-release-notes.sh later turns into a release body, and a second
# harness would be a second CI job for one assertion.
#
# v2.9.0 was cut twice through a script that exited 141. `git diff |
# head -60` under `set -o pipefail`: head closes the pipe, git takes
# SIGPIPE, and `set -e` ends the script — after the fold is on disk but
# before the EDITORIAL PASS notice and the next-steps block print. Those
# are the only instructions the operator gets for writing the headline
# the script deliberately leaves as a placeholder, so the failure mode is
# a CHANGELOG that publishes `<HEADLINE — replace this paragraph…>` as
# the release page's opening line. See #1024.
#
# Two things about the fixture, both learned by watching a smaller one
# pass against the unfixed script.
#
# It needs TWO pre-release sections, each carrying both kinds. One
# section of one kind leaves the bullets textually where they are and
# only rewrites the headings around them, so the diff is a dozen lines.
# Merging by kind across two sections is what makes dev.2's Bug bullets
# travel down past dev.1's Feature bullets.
#
# And the diff has to outrun the PIPE BUFFER, which is not the same
# thing as outrunning `head`'s 60-line window. head does not close the
# pipe until it has read its 60 lines and exited, and a diff under 64 KiB
# is already sitting in the buffer by then with git finished and gone —
# there is no writer left to signal. A 216-line diff of short bullets
# exits 0. The same 216 lines of paragraph-length bullets is 80 KiB, git
# blocks mid-write, head exits, and git takes the SIGPIPE. So the bullets
# below are padded to the length this repo's CHANGELOG entries actually
# run to; that length is the reproducer, and it is why the real thing hit
# this on every single GA fold.
BULLET_PAD='A bullet whose body is a paragraph, because that is what this repo actually writes: every entry states what changed, then why it was wrong before, then what an operator has to do differently, and it does all of that on one physical line. That length is not decoration here — it is the precondition for the bug this case exists to catch, because a fold diff only overruns the pipe buffer when the lines going through it are this size.'
start_case 'the GA fold exits 0 and still prints the next-steps block'
init_repo "$REPO3"
{
  printf '# Changelog\n\n## [Unreleased]\n\n_No unreleased changes since [1.1.0-dev.2]._\n\n'
  for rel in 2 1; do
    printf '## [1.1.0-dev.%d]\n\n### Changes by Kind\n\n#### Feature\n\n' "$rel"
    for ((i = 0; i < 80; i++)); do
      printf -- '- **Feature %d-%04d.** %s\n' "$rel" "$i" "$BULLET_PAD"
    done
    printf '\n#### Bug or Regression\n\n'
    for ((i = 0; i < 80; i++)); do
      printf -- '- **Fix %d-%04d.** %s\n' "$rel" "$i" "$BULLET_PAD"
    done
    printf '\n'
  done
  printf '## [1.0.0] — 2026-01-01\n\n- the first thing\n'
} > "$REPO3/CHANGELOG.md"
git -C "$REPO3" add CHANGELOG.md
git -C "$REPO3" commit -qm 'docs: changelog'
git -C "$REPO3" tag v1.0.0
FOLD_OUT="$REPO3/fold.out"
if ( cd "$REPO3" && "$CUTGA" v1.1.0 ) >"$FOLD_OUT" 2>"${FOLD_OUT}.err"; then
  :
else
  fail "cut-ga-tag.sh exited $? on a successful fold (141 means the SIGPIPE is back)"
fi
assert_contains "$FOLD_OUT" 'EDITORIAL PASS REQUIRED'
assert_contains "$FOLD_OUT" 'next steps'
# The truncation itself must survive the fix — the point was never to
# print the whole diff, only to stop dying of it.
assert_contains "$FOLD_OUT" '── diff (head) ─'
if [[ "$(grep -c . "$FOLD_OUT")" -gt 200 ]]; then
  fail "the diff preview is no longer truncated"
fi
# And the fold it was in the middle of is still correct.
assert_contains "$REPO3/CHANGELOG.md" '## [1.1.0]'
assert_absent "$REPO3/CHANGELOG.md" '## [1.1.0-dev.1]'

if [[ "$FAILURES" -ne 0 ]]; then
  echo "verify-release-notes: ${FAILURES} assertion(s) failed" >&2
  exit 1
fi
echo "verify-release-notes: all cases passed"
