# A curl that answers the attach hub from fixtures, for dryrun.sh. Same
# contract as the fake kubectl beside it: it answers exactly the
# requests the drill makes and fails loudly on anything else.
set -uo pipefail

FAKE="${DRILL_FAKE_DIR:?fake curl requires DRILL_FAKE_DIR}"
printf 'curl %s\n' "$*" >> "${FAKE}/calls.log"

# drill_require_curl_version reads both of these before anything else.
case "${1:-}" in
    --version)
        printf 'curl 8.5.0 (x86_64-fake) libcurl/8.5.0\n'
        exit 0 ;;
    --help)
        printf '     --fail-with-body  Fail on HTTP errors but save the body\n'
        exit 0 ;;
esac

url="" method="GET" body=""
while (( $# )); do
    case "$1" in
        http://*|https://*) url="$1" ;;
        -X)                 method="$2"; shift ;;
        --data|-d)          body="$2"; shift ;;
    esac
    shift
done
[[ -n "${url}" ]] || { printf 'fake curl: no URL in argv\n' >&2; exit 64; }
path="/${url#*://*/}"

# ── The hub ──────────────────────────────────────────────────────────

# GET /sessions. The incident session only appears once something has
# actually broken the cluster — the fake kubectl drops the marker — so
# drill_wait_new_session is exercised rather than short-circuited.
if [[ "${path}" == "/sessions" ]]; then
    if [[ -f "${FAKE}/broken" && "${FAKE_NO_INCIDENT:-}" != "1" ]]; then
        cat "${FAKE}/sessions-after.json"
    else
        cat "${FAKE}/sessions-before.json"
    fi
    exit 0
fi

# POST /sessions/<app>/<sid>/inject
if [[ "${path}" == */inject ]]; then
    [[ "${method}" == "POST" ]] || { printf 'fake curl: inject must be POST\n' >&2; exit 64; }
    printf '%s\n' "${body}" > "${FAKE}/inject-body.json"
    touch "${FAKE}/injected"
    if [[ "${FAKE_INJECT_FAILS:-}" == "1" ]]; then
        printf '{"error":"session not accepting input"}\n'
        exit 22
    fi
    printf '{"queued":true,"woke":true}\n'
    exit 0
fi

# GET /sessions/<app>/<sid>/subagents — the CONFIGURED roster.
if [[ "${path}" == */subagents ]]; then
    if [[ "${FAKE_NO_SUBAGENTS:-}" == "1" || "${FAKE_NO_AGENTS:-}" == "1" ]]; then
        printf '{"subagents":[]}\n'
    else
        printf '{"subagents":[{"name":"cluster"}]}\n'
    fi
    exit 0
fi

# GET /sessions/<app>/<sid>/agents/<name>/events — one subagent's turns.
if [[ "${path}" == */agents/*/events* ]]; then
    name="${path#*/agents/}"; name="${name%%/*}"
    src="${FAKE}/subagent-${name}.json"
    [[ -f "${src}" ]] || { printf '{"error":"no such subagent: %s"}\n' "${name}"; exit 0; }
    if [[ "${FAKE_PAGINATE:-}" == "1" ]]; then
        # One event, then the rest — so the merge loop in
        # drill_capture_subagents is actually executed. A bug there
        # halves the evidence silently, and the parent stream carries
        # almost none of it for this recipe.
        since="${path##*since=}"; since="${since%%&*}"
        jq -c --argjson s "${since}" '
            if $s == 0 and (.events | length) > 1
            then {events: .events[0:1], truncated: true, next_since: 1}
            else {events: .events[$s:], truncated: false}
            end' "${src}"
    else
        cat "${src}"
    fi
    exit 0
fi

# GET /sessions/<app>/<sid>/agents — LIVE instances, the fallback the
# drill takes when the roster comes back empty.
if [[ "${path}" == */agents ]]; then
    if [[ "${FAKE_NO_AGENTS:-}" == "1" ]]; then
        printf '{"agents":[]}\n'
    else
        printf '{"agents":[{"name":"cluster"}]}\n'
    fi
    exit 0
fi

# GET /sessions/<app>/<sid>/events?since=0 — the parent SSE stream.
#
# Dump the fixture, then hold the connection open. Holding it is the
# point: it makes drill_capture_parent exit through its QUIESCENCE
# branch, which is the one a live run takes. Letting curl exit here
# would exercise the "server hung up" branch instead and quietly stop
# testing the timer that actually ends every real capture.
if [[ "${path}" == */events* ]]; then
    cat "${FAKE}/events.sse"
    exec sleep 3600
fi

printf 'fake curl: unhandled path %s\n' "${path}" >&2
exit 64
