# A kubectl that answers from a fixture instead of a cluster, for
# dryrun.sh. It exists so the drill's 730 lines of control flow can be
# executed without spending a cluster day to find a typo.
#
# It is NOT a kubectl emulator. It answers exactly the invocations the
# drill and the recipe's break-workload.sh make, and nothing else — an
# unrecognised invocation is a loud failure rather than a plausible
# empty string, because a fake that shrugs at a command the drill really
# issues would let a broken drill pass a dry run.
#
# Every call is appended to ${DRILL_FAKE_DIR}/calls.log, which is how
# dryrun.sh asserts that the break landed and the restore ran.
set -uo pipefail

FAKE="${DRILL_FAKE_DIR:?fake kubectl requires DRILL_FAKE_DIR}"
printf 'kubectl %s\n' "$*" >> "${FAKE}/calls.log"

# ── Mutable fixture state ────────────────────────────────────────────
# Survives across invocations, because the drill breaks in one process
# and verifies the restore in another.
STATE="${FAKE}/kubectl-state.env"
GEN="${FAKE_GENERATION:-3}"
IMG="${FAKE_WORKLOAD_IMAGE:-gcr.io/google-samples/microservices-demo/emailservice:v0.10.3}"
PROBE="present"
PATCHED="no"
if [[ -f "${STATE}" ]]; then
    # shellcheck source=/dev/null
    source "${STATE}"
fi
save_state() {
    printf 'GEN=%q\nIMG=%q\nPROBE=%q\nPATCHED=%q\n' \
        "${GEN}" "${IMG}" "${PROBE}" "${PATCHED}" > "${STATE}"
}

# ── Scenario D: the agent patches, mid-turn ──────────────────────────
#
# The drill never issues the agent's patch — the agent does, inside the
# cluster, while the drill is holding the SSE stream open. So the fake
# models it the same way: the fake curl drops `captured` when the real
# capture starts, and the first read after that sees a healed workload.
#
# Not a `kubectl patch` branch, deliberately. A branch there would only
# fire if something in the drill ran the patch, and nothing in the drill
# should. Tying it to the capture instead means a drill that accidentally
# patched the cluster itself would NOT light this up, and the dry run
# would still say the object moved for the wrong reason.
#
# Idempotent through PATCHED rather than through the tag: a case that
# arms FAKE_AGENT_PATCHED_IMAGE to a SECOND unpullable tag — the agent
# that "fixed" it and did not — must still advance the generation exactly
# once, and a tag test would re-fire on every read.
if [[ "${FAKE_AGENT_PATCHES:-}" == "1" && -f "${FAKE}/captured" && "${PATCHED}" != "yes" ]]; then
    IMG="${FAKE_AGENT_PATCHED_IMAGE:-gcr.io/google-samples/microservices-demo/emailservice:v0.10.3}"
    GEN=$(( GEN + 1 ))
    PATCHED="yes"
    save_state
fi

die() { printf 'fake kubectl: %s\n' "$*" >&2; exit 64; }

# ── Argument normalisation ───────────────────────────────────────────
# Drop the flags the drill sets on every call so the dispatch below can
# match on the verb and its operands alone.
argv=()
while (( $# )); do
    case "$1" in
        --context)          shift 2 ;;
        --context=*)        shift ;;
        -n|--namespace)     shift 2 ;;
        -n=*|--namespace=*) shift ;;
        *)                  argv+=("$1"); shift ;;
    esac
done
set -- ${argv[@]+"${argv[@]}"}
j="$*"

# Substring match with the needle treated as a LITERAL — the jsonpath
# expressions the drill sends contain `[`, `?` and `(`, all of which are
# glob metacharacters, so an unquoted pattern would match the wrong
# things (or nothing) in ways that are very hard to see.
has() { [[ "${j}" == *"$1"* ]]; }

# ── Dispatch ─────────────────────────────────────────────────────────

# prereqs.sh, only when KUBE_CONTEXT is unset.
if [[ "${j}" == "config current-context" ]]; then
    printf '%s\n' "${FAKE_KUBE_CONTEXT:-fixture-context}"
    exit 0
fi

# drill_port_forward. The drill probes the port with a bare TCP connect
# and treats our exit as fatal, so this has to really bind and really
# stay up. exec so the drill's kill lands on the listener, not on a
# shell whose child outlives it.
if [[ "${1:-}" == "port-forward" ]]; then
    port="${3%%:*}"
    exec python3 -c '
import socket, sys, time
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", int(sys.argv[1])))
s.listen(16)
time.sleep(3600)
' "${port}"
fi

# drill_preflight: namespaces.
if [[ "${j}" == "get ns "* ]]; then
    ns="${2:-}"
    [[ " ${FAKE_MISSING_NS:-} " == *" ${ns} "* ]] && exit 1
    exit 0
fi

# drill_preflight: readiness of the two Deployments we score.
if has 'get deploy core-agent -o jsonpath={.status.readyReplicas}'; then
    printf '%s' "${FAKE_READY_AGENT:-1}"; exit 0
fi
if has 'get deploy lookout-watch -o jsonpath={.status.readyReplicas}'; then
    printf '%s' "${FAKE_READY_LOOKOUT:-1}"; exit 0
fi

# foreign_watchers: "<namespace> <availableReplicas>" per line, empty
# means clear. awk in prereqs.sh filters DEMO_NS out itself.
if has 'get deploy -A' && has 'app.kubernetes.io/name=lookout-watch'; then
    printf '%s\n' "${FAKE_FOREIGN_WATCHERS:-}"
    exit 0
fi

# Run attribution: daemon image (by container name, then by index) and
# the content image on either delivery overlay.
#
# The volume name below is load-bearing. deploy/base names it
# "recipe-content"; this fake answered to "content" for as long as
# drill.sh asked for "content", so 119 green assertions said nothing
# about whether either matched the manifest. Both now name what the
# manifest names, and a run that resolves no content image warns.
if has 'containers[?(@.name=="core-agent")].image'; then
    printf '%s' "${FAKE_DAEMON_IMAGE:-}"; exit 0
fi
if has 'get deploy core-agent' && has 'containers[0].image'; then
    printf '%s' "${FAKE_DAEMON_IMAGE_BY_INDEX:-}"; exit 0
fi

# drill_deployed_config. A JSON array, because that is what jsonpath
# renders for `.args` and the caller pipes it through jq — an answer
# shaped as a bare string would make jq's `index("-c")` return null and
# the drill would report "could not read the -c" on a correct manifest.
#
# FAKE_DEPLOYED_ARGS overrides the whole array, which is how a case arms
# the read-only leg and the unreadable one.
if has 'containers[?(@.name=="core-agent")].args'; then
    if [[ -n "${FAKE_DEPLOYED_ARGS+x}" ]]; then
        printf '%s' "${FAKE_DEPLOYED_ARGS}"
    else
        printf '["serve","--session-db-path=/data/sessions.db","-c","%s"]' \
            "${FAKE_DEPLOYED_CONFIG:-/content/recipes/gke-platform-agent/gated-apply/.agents/config.d1.json}"
    fi
    exit 0
fi

if has 'volumes[?(@.name=="recipe-content")].image.reference'; then
    printf '%s' "${FAKE_CONTENT_IMAGE:-}"; exit 0
fi
if has 'initContainers[?(@.name=="install-content")].image'; then
    printf '%s' "${FAKE_CONTENT_IMAGE_INIT:-}"; exit 0
fi

# G4's two witnesses. The fingerprint jsonpath also mentions
# .metadata.generation, so it has to be matched FIRST or the
# single-workload generation read below swallows it.
if has 'get deploy,statefulset,daemonset'; then
    # `@GEN@` expands to the live generation, so a case can have the
    # fingerprint move when the object moves. Without it the two
    # snapshots are the same static string on every run, and D4's first
    # witness would report "the workload's own fingerprint did not move"
    # on a run where it demonstrably did.
    fp="${FAKE_FP_WORKLOADS:-}"
    printf '%s\n' "${fp//@GEN@/${GEN}}"; exit 0
fi
if has 'get sa,role,rolebinding,cm,secret'; then
    printf '%s\n' "${FAKE_FP_OBJECTS:-}"; exit 0
fi
if has '{.metadata.generation}'; then
    printf '%s' "${GEN}"; exit 0
fi

# D4's first witness: readiness of the SCENARIO's workload. Must come
# after the two named Deployments above, which are the drill's own and
# are read by the same jsonpath.
#
# Derived from the tag rather than set independently, because that is the
# relationship the witness is actually asserting: an unpullable image
# means no Ready replica. A case that patches one bad tag to another gets
# a moved generation, a changed image string and a still-broken workload
# for free — which is the interesting failure, and the reason readiness
# is part of the witness at all.
#
# Which tags are unpullable is a REGEX and not the literal the drill
# breaks with, so a case can arm a tag the drill would never write. That
# matters: while "unpullable" and "contains does-not-exist" were the same
# set, a scenario predicate that tested for the drill's own break string
# looked identical to one that tested health, and no dry-run case could
# tell them apart.
if has '{.status.readyReplicas}'; then
    if [[ "${IMG}" =~ ${FAKE_UNREADY_IMAGE_RE:-does-not-exist} ]]; then printf ''
    else printf '%s' "${FAKE_TARGET_REPLICAS:-1}"; fi
    exit 0
fi
if has '{.spec.replicas}'; then
    printf '%s' "${FAKE_TARGET_REPLICAS:-1}"; exit 0
fi

# ── Scenario A, via the recipe's break-workload.sh ───────────────────

if has 'containers[0].name'; then
    printf '%s' "${FAKE_WORKLOAD_CONTAINER:-server}"; exit 0
fi
if [[ "${1:-}" == "set" && "${2:-}" == "image" ]]; then
    IMG="${4#*=}"
    GEN=$(( GEN + 1 ))
    save_state
    touch "${FAKE}/broken"
    printf 'deployment.apps/%s image updated\n' "${3#deployment/}"
    exit 0
fi
if has 'containers[0].image'; then
    printf '%s' "${IMG}"; exit 0
fi
if [[ "${1:-}" == "rollout" && "${2:-}" == "undo" ]]; then
    # FAKE_RESTORE_BROKEN reproduces the one failure mode the recipe's
    # DEMO.md warns about: `rollout undo` exits 0 having done nothing,
    # so only checking the outcome catches it.
    if [[ "${FAKE_RESTORE_BROKEN:-}" == "1" ]]; then
        printf 'deployment.apps/%s rolled back\n' "${3#deployment/}"
        exit 0
    fi
    IMG="${FAKE_WORKLOAD_IMAGE:-gcr.io/google-samples/microservices-demo/emailservice:v0.10.3}"
    GEN=$(( GEN + 1 ))
    save_state
    printf 'deployment.apps/%s rolled back\n' "${3#deployment/}"
    exit 0
fi
if has '{.spec.progressDeadlineSeconds}'; then
    printf '600'; exit 0
fi
if [[ "${1:-}" == "rollout" && "${2:-}" == "status" ]]; then
    printf 'deployment "%s" successfully rolled out\n' "${3#deployment/}"
    exit 0
fi
if [[ "${1:-}" == "patch" ]]; then
    exit 0
fi

# ── Scenario C, via its own fixture ──────────────────────────────────

if [[ "${1:-}" == "apply" ]]; then
    # FAKE_PROBE_STATE lets a dry-run case arm the fixture into a state
    # other than the happy one: `pending` is the pod that never starts,
    # `healthy` the cluster that grants pod-list to everyone, and
    # `imagepull` the fixture whose own image is wrong. Default is the
    # state a correct cluster produces.
    PROBE="${FAKE_PROBE_STATE:-crashloop}"
    save_state
    touch "${FAKE}/broken"
    printf 'serviceaccount/drill-rbac-probe created\ndeployment.apps/drill-rbac-probe created\n'
    exit 0
fi
if [[ "${1:-}" == "delete" ]]; then
    PROBE="absent"
    save_state
    printf 'serviceaccount "drill-rbac-probe" deleted\ndeployment.apps "drill-rbac-probe" deleted\n'
    exit 0
fi
# The arm loop's combined read: phase|waiting.reason|restartCount, one
# call so the three can never be read at different instants. This must
# be matched BEFORE the bare `state.waiting.reason` branch below, which
# is a substring of it.
if has '{.items[0].status.phase}|'; then
    case "${PROBE}" in
        crashloop) printf 'Running|CrashLoopBackOff|3' ;;
        pending)   printf 'Pending||0' ;;
        imagepull) printf 'Pending|ImagePullBackOff|0' ;;
        healthy)   printf 'Running||0' ;;
        absent)    : ;;                # no pod at all -> empty output
        *)         printf 'Running||0' ;;
    esac
    exit 0
fi
if has 'state.waiting.reason'; then
    [[ "${PROBE}" == "crashloop" ]] && printf 'CrashLoopBackOff'
    exit 0
fi
if has '{.items[0].status.phase}'; then
    printf 'Running'; exit 0
fi
# Forensics, taken on the failure paths only. Content does not matter
# to the assertions; that it was collected before the delete does.
if [[ "${1:-}" == "describe" ]]; then
    printf 'Name: drill-rbac-probe-abc\nEvents:\n  FailedScheduling  no nodes available\n'
    exit 0
fi
if [[ "${1:-}" == "logs" ]]; then
    has '--previous' && { printf 'previous terminated container not found\n'; exit 1; }
    printf 'drill-rbac-probe: starting up in namespace online-boutique\n'
    exit 0
fi
if has 'get pods' && has '-o wide'; then
    printf 'NAME                     READY   STATUS    RESTARTS   AGE\ndrill-rbac-probe-abc     0/1     Pending   0          4m\n'
    exit 0
fi

# Bare existence checks: break-workload.sh's guard, and scenario C's
# scenario_verify_restored, which passes only when the probe is gone.
if [[ "${j}" == "get deploy "* && ${#argv[@]} -eq 3 ]]; then
    [[ "${3}" == "drill-rbac-probe" && "${PROBE}" == "absent" ]] && exit 1
    printf 'NAME   READY   UP-TO-DATE   AVAILABLE   AGE\n%s   1/1     1            1           1d\n' "${3}"
    exit 0
fi

die "unhandled invocation: ${j}"
