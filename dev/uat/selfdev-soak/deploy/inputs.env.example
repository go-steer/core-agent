# The operator's values for the soak rig. Copy this file OUTSIDE the
# repository (the runbook uses ~/.gke-drill/selfdev-soak/inputs.env),
# fill in every value, and pass it to render.sh with --inputs. None of
# these is a secret; the secrets are Kubernetes Secrets (README.md).
#
# Every value below is a placeholder that fails closed: render.sh
# refuses any output still containing REPLACE, and each one also fails
# on its own if applied anyway (noted per line).
#
# The soak image by digest, as build-image.sh --push prints it:
# <registry>/core-agent-selfdev-soak@sha256:<64 hex>. Not a tag.
# (Placeholder: not a valid image reference, so the pod never starts.)
SOAK_IMAGE=REPLACE-WITH-REGISTRY/core-agent-selfdev-soak@sha256:REPLACE-WITH-DIGEST
# The Google Cloud project whose Vertex AI serves Claude to the daemon.
# (Placeholder: every model call fails.)
SOAK_VERTEX_PROJECT=REPLACE-WITH-VERTEX-PROJECT
# The soak Slack channel's ID, for the switchboard alert target.
# (Placeholder: contains spaces, which config validation refuses, so
# the daemon exits at startup.)
SOAK_SLACK_CHANNEL=REPLACE WITH THE SOAK SLACK CHANNEL ID
# The writer GitHub App's numeric App ID.
# (Placeholder: not a number, so the dispatcher exits 2.)
SOAK_APP_ID=REPLACE-WITH-WRITER-APP-ID
# The soak's dedicated commit identity (decision 16): human-looking,
# not the maintainer's own, not a bot or noreply address, and named in
# the MIRROR's attribution allowlist only.
# (Placeholder email has no @, so the dispatcher exits 2.)
SOAK_COMMIT_NAME=REPLACE WITH THE SOAK COMMIT NAME
SOAK_COMMIT_EMAIL=REPLACE-WITH-SOAK-COMMIT-EMAIL
