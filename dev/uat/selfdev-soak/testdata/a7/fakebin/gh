"""A stand-in for `gh api` in grade_a7_selftest.py. Never reaches GitHub.

Answers two GET paths from files in $FAKE_GH_DIR:

    repos/<owner>/<repo>/pulls/<n>                 -> pulls.json
    repos/<owner>/<repo>/actions/runs?head_sha=... -> runs.json

Every invocation is appended to $FAKE_GH_DIR/calls.log, one JSON argv per
line, so the self-test can assert the grader only ever read. Anything
else, any flag, or a missing file fails like gh does: non-zero, message
on stderr. $FAKE_GH_FAIL makes every call fail.
"""

import json
import os
import pathlib
import re
import sys

d = pathlib.Path(os.environ["FAKE_GH_DIR"])
with (d / "calls.log").open("a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_GH_FAIL"):
    sys.stderr.write("HTTP 502: Bad Gateway (fake)\n")
    sys.exit(1)
args = sys.argv[1:]
if len(args) != 2 or args[0] != "api":
    sys.stderr.write(f"fake gh: unsupported invocation {args}\n")
    sys.exit(2)
path = args[1]
if re.fullmatch(r"repos/[^/]+/[^/]+/pulls/\d+", path):
    name = "pulls.json"
elif re.fullmatch(r"repos/[^/]+/[^/]+/actions/runs\?head_sha=[0-9a-f]{40}&per_page=100", path):
    name = "runs.json"
else:
    sys.stderr.write(f"fake gh: no fixture for {path}\n")
    sys.exit(1)
f = d / name
if not f.is_file():
    sys.stderr.write("HTTP 404: Not Found (fake)\n")
    sys.exit(1)
sys.stdout.write(f.read_text())
