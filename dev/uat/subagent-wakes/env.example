# Copy to .env (git-ignored) and fill in your project. run.sh reads it on
# every command; anything already exported in your shell wins.
#
# Claude on Vertex. Auth comes from gcloud application-default
# credentials (gcloud auth application-default login).
MODEL_PROVIDER=anthropic-vertex
MODEL_NAME=claude-haiku-4-5
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project
CLOUD_ML_REGION=global

# Or Gemini on Vertex:
# MODEL_PROVIDER=vertex
# MODEL_NAME=gemini-3.7-flash
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional:
# WAKE_SECS=40   # how long the watcher sleeps between reads
# PORT=7791      # the headless daemon's attach port
