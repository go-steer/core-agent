# A fake kubectl for the hermetic demo and tests: it answers the
# handful of verbs the scripted transcripts issue with plausible
# output and never touches a cluster. Put it first on PATH.
set -uo pipefail

case "${1:-}" in
  apply)
    echo "job.batch/preflight-maxtext-v5e-256 created"
    ;;
  wait)
    echo "job.batch/preflight-maxtext-v5e-256 condition met"
    ;;
  get)
    echo "NAME                                READY   STATUS      RESTARTS   AGE"
    echo "preflight-maxtext-v5e-256-0-abcde   0/1     Completed   0          3m"
    ;;
  logs)
    echo "jax.devices() = 256 (TpuDevice)"
    echo "completed step 1/1 loss=8.31"
    ;;
  delete)
    echo 'job.batch "preflight-maxtext-v5e-256" deleted'
    ;;
  *)
    echo "fake kubectl: unhandled verb: ${1:-}" >&2
    exit 1
    ;;
esac
